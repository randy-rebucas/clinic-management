  @@index([tenantId, visitId])
  @@index([tenantId, orderedById])
  @@index([tenantId, reportedById])
  @@index([tenantId, status])
  @@index([tenantId, orderedById, orderDate])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, patientId, status])
  @@index([tenantId, modality])
}

model ImagingAttachment {
