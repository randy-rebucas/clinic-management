
# ──────────────────────────────────────────────────────────────────────────────
# Clinic Management — Environment Variables
# Copy this file to .env.local and fill in real values before running.
# NEVER commit .env.local or any file with real credentials.
# Placeholders below are examples only; generate your own secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# The server refuses to start in production if any of these are missing/malformed
# (see lib/env-validation.ts).

# MongoDB connection string
# Local development (.env.local): the Docker database, see docs/LOCAL_DEV_DATABASE.md
#   mongodb://127.0.0.1:27017/clinic-management
# Production (Vercel, and .env.prod.local for `pnpm prod <script>`):
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clinic?retryWrites=true&w=majority
MONGODB_URI=

# Session (JWT) signing secret — min 32 chars. Also keys appointment confirm/cancel links.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Bearer token for /api/cron/* — min 32 chars. Vercel Cron sends
# "Authorization: Bearer $CRON_SECRET" automatically; the x-vercel-cron header alone is NOT accepted.
# Generate: openssl rand -base64 32
CRON_SECRET=

# AES-256 field encryption key — exactly 64 hex chars (32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Install / Bootstrap ───────────────────────────────────────────────────────

# Bearer secret for /install and /api/install/* — min 32 chars. Those routes are
# disabled when unset (in every environment). Remove it after the first setup.
# Generate: openssl rand -base64 32
INSTALL_SECRET=
# The install wizard's "reset database" deletes every clinic's data, so it refuses once any
# clinic exists. Set to true only for a deliberate wipe, then unset.
INSTALL_ALLOW_RESET=

# ── Multi-Tenancy ─────────────────────────────────────────────────────────────

# Apex domain used to resolve tenant subdomains and for the CSRF origin check
# Example: myclinic.com  (tenant subdomains: clinic1.myclinic.com)
ROOT_DOMAIN=

# Cookie domain for cross-subdomain sessions (include the leading dot)
# Example: .myclinic.com — leave empty for single-domain or local development
COOKIE_DOMAIN=

# ── Platform console (super-admin) ────────────────────────────────────────────

# Comma-separated emails allowed into /platform on the root domain (all clinics, MRR,
# support queue, view-as-clinic). They sign in with an emailed single-use link; removing
# an address ends access immediately. Empty = console disabled.
PLATFORM_ADMIN_EMAILS=
# Writes the sign-in link to the server log as well (always on in development). Only for
# when SMTP isn't working yet: anyone who can read the logs can then sign in.
# PLATFORM_LINK_TO_LOG=true

# ── Rate limiting (optional)──────────────────────────────────────────────────

# Upstash Redis REST credentials. Set both or neither. When unset, rate limits and the session
# cache are kept in per-instance memory (not shared across serverless instances).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; those work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile on public booking and patient self-registration. Set both to turn it on;
# with only the secret set, every public booking is refused.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Payments (PayMongo, Philippines) ──────────────────────────────────────────
# The platform's own PayMongo account: clinics' plan subscriptions are charged here, in pesos
# (GCash, Maya, cards, QR Ph). Prefer setting the keys in Platform → Configuration (stored
# encrypted); these env values are only the fallback until that is done.
# sk_test_… or sk_live_…
PAYMONGO_SECRET_KEY=
# Register a webhook for checkout_session.payment.paid at <app url>/api/paymongo/webhook;
# PayMongo returns this secret (whsk_…) when it's created.
PAYMONGO_WEBHOOK_SECRET=
# Medical representative activation fee in pesos (20 or more). Unset = activated by hand.
# Fallback only: Platform → Configuration → Fees overrides it once saved.
MEDREP_ACTIVATION_FEE_PHP=
# Public rep self-registration at /medical-representatives/onboard. Leave unset until the rep app
# ships: without it a registered (and paid) rep has nothing to sign in to.
MEDREP_SELF_SIGNUP_ENABLED=

# ── AI scribe (Claude) ────────────────────────────────────────────────────────
# Drafts visit notes from a dictated or pasted consult (Professional/Enterprise plans).
# Unset = the AI scribe button is hidden. Patient names are never sent; see lib/ai-scribe.ts.
ANTHROPIC_API_KEY=

# ── Teleconsult (video visits) ────────────────────────────────────────────────
# Jitsi deployment for video rooms. Default https://meet.jit.si (free; asks the first person
# in a room to sign in as moderator). A self-hosted Jitsi or 8x8 JaaS URL removes that.
TELECONSULT_BASE_URL=

# ── PDF rendering ─────────────────────────────────────────────────────────────
# Local dev only: path to Chrome/Edge for ?format=pdf if it isn't in a standard location.
# On Vercel the bundled @sparticuz/chromium binary is used.
CHROME_EXECUTABLE_PATH=

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
# Required for sending SMS AND for verifying the X-Twilio-Signature on the
# inbound SMS webhook (requests are rejected when it is unset).
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +15005550006
TWILIO_PHONE_NUMBER=

# ── Email (SMTP / Nodemailer) ─────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if not set
SMTP_FROM=

# ── File Storage (Cloudinary) ─────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push Notifications (Web Push / VAPID) ─────────────────────────────────────

# Generate a keypair: pnpm dlx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Error Tracking (optional) ─────────────────────────────────────────────────

# Sentry is completely inactive unless a DSN is set (no SDK is loaded, nothing is sent).
# Unhandled server errors are always logged as structured JSON (instrumentation.ts).
# PHI: events are scrubbed before sending (lib/sentry-scrub.ts): no request bodies, cookies,
# auth headers or query strings; user data reduced to an opaque id; patient fields (names, phone,
# email, diagnosis, notes, medications, date of birth, address) filtered; no Session Replay.
# Server-side DSN (falls back to NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
# Browser DSN (inlined at build time; events go through the same-origin /monitoring tunnel).
# Example: https://<publicKey>@o<orgId>.ingest.sentry.io/<projectId>
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of requests traced, 0..1 (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Browser trace sample rate (falls back to SENTRY_TRACES_SAMPLE_RATE)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Source-map upload at build time: all three must be set, otherwise nothing is uploaded.
# SENTRY_AUTH_TOKEN=sntrys_<token>
# SENTRY_ORG=<org-slug>
# SENTRY_PROJECT=<project-slug>

# ── Lab Integration (optional) ────────────────────────────────────────────────

# HMAC-SHA256 secret for verifying third-party lab webhooks.
# Required if receiving lab results via webhook (requests are rejected when unset).
# Generate: openssl rand -base64 32
LAB_WEBHOOK_SECRET=
# Labs sign `<X-Webhook-Timestamp>.<raw body>` (HMAC-SHA256, sent as X-Webhook-Signature: sha256=<hex>);
# deliveries more than 5 minutes off are refused. A lab with its own webhookSecret in LAB_INTEGRATIONS
# sends X-Lab-Code and can only write to requests sent to it.
# Temporarily accept the old body-only signature (no timestamp) while labs move over:
# LAB_WEBHOOK_LEGACY_SIGNATURES=true

# Server-side lab API configuration: a JSON array (single line) of
#   { "labCode", "labName", "apiEndpoint", "apiKey", "apiSecret"?, "labId"?, "tenantIds"? }
# An entry with tenantIds is only usable by those clinics. Endpoints must be public https URLs.
# Example:
# LAB_INTEGRATIONS=[{"labCode":"ACME","labName":"Acme Diagnostics","apiEndpoint":"https://api.acme-lab.example/v1/orders","apiKey":"<key>","webhookSecret":"<secret>","tenantIds":["<tenantObjectId>"]}]
LAB_INTEGRATIONS=

# Optional comma-separated allowlist of hostnames lab API calls may reach
# Example: api.acme-lab.example,lab.partner.example
LAB_API_ALLOWED_HOSTS=

# ── Document seals ────────────────────────────────────────────────────────────

# HMAC key that signs printed-document seals (prescriptions, certificates, receipts)
# Generate: openssl rand -base64 48
# Strongly recommended: if unset, a key derived from SESSION_SECRET is used, so
# rotating SESSION_SECRET would make every previously printed seal fail verification.
DOCUMENT_SEAL_SECRET=

# Canonical origin printed in document QR codes (defaults to the request host)
DOCUMENT_VERIFY_BASE_URL=

# Set to "off" to disable the DevTools trap on protected documents (always off outside production)
DOCUMENT_ANTI_INSPECT=

# ── Application ───────────────────────────────────────────────────────────────

# Public-facing app URL (used in emails, SMS links, FHIR resources, sitemaps)
NEXT_PUBLIC_APP_URL=https://myclinic.example.com

# Base URL for staff invite / set-password links and platform console sign-in links (optional; takes priority over NEXT_PUBLIC_APP_URL).
# Links are moved onto the clinic's subdomain of ROOT_DOMAIN automatically.
# APP_BASE_URL=https://myclinic.example.com

# Application display name
NEXT_PUBLIC_APP_NAME=Clinic Management

# RxNav REST base URL for RxNorm medicine-name suggestions (defaults to the NLM public API)
# RXNAV_API_URL=https://rxnav.nlm.nih.gov/REST

# eMCR patient app
# Require a paid activation before eMCR accounts can be used (default: off)
# EMCR_ACTIVATION_ENFORCED=true
# Domain of structured eMCR login IDs (default: myclinicsoft.solutions)
# EMCR_LOGIN_DOMAIN=myclinicsoft.solutions
# Link to the eMCR app in messages to patients (default: <NEXT_PUBLIC_APP_URL>/emcr)
# EMCR_APP_URL=https://myclinic.example.com/emcr
# App store link shown on the public site (hidden when unset)
# NEXT_PUBLIC_EMCR_APP_STORE_URL=

# Search engine site verification tokens (optional)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Fallback base URL for the Twilio webhook signature check when NEXT_PUBLIC_APP_URL is unset
# APP_URL=https://myclinic.example.com
