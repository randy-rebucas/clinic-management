  imagingId    String   @db.Uuid
  imaging      Imaging  @relation(fields: [imagingId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String?
  size         Int?
  url          String?
  gridFsId     String?
  uploadedById String?  @db.Uuid
  uploadDate   DateTime @default(now())
  notes        String?

  @@index([imagingId])
}

// ============================================================================
// Procedure
