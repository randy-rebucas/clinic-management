  instructions String

  @@index([visitId])
}

// 1:1 embedded object with all-or-nothing validation in Mongoose -> own table (not flattened)
// so the "all required fields present or none" app-level rule stays enforceable via a
// row's presence/absence, and providerId keeps a real FK relation.
model VisitDigitalSignature {
  id             String   @id @default(uuid()) @db.Uuid
  visitId        String   @unique @db.Uuid
  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  providerName   String
  providerId     String   @db.Uuid
  provider       User     @relation(fields: [providerId], references: [id])
  signatureData  String
  signedAt       DateTime @default(now())
  ipAddress      String?

  @@index([providerId])
}

model VisitAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  visitId      String   @db.Uuid
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String?
  size         Int?
  url          String?
  gridFsId     String?
  uploadedById String?  @db.Uuid
  uploadDate   DateTime @default(now())
  notes        String?

  @@index([visitId])
}

// ============================================================================
// Prescription
// ============================================================================

model Prescription {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  prescriptionCode String

  visitId String? @db.Uuid
  visit   Visit?  @relation(fields: [visitId], references: [id])

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  prescribedById String? @db.Uuid
  prescribedBy   User?   @relation("PrescriptionPrescribedBy", fields: [prescribedById], references: [id])

  issuedAt DateTime @default(now())

  medications PrescriptionMedication[]

  notes String?

  status PrescriptionStatus @default(active)

  pharmacyDispenseId String? // legacy field, superseded by pharmacyDispenses
  pharmacyDispenses  PrescriptionPharmacyDispense[]

  // digitalSignature (flattened - fixed shape struct, no FK to User here — providerName is a text snapshot)
  digitalSignatureProviderName  String?
  digitalSignatureData          String?
  digitalSignatureSignedAt      DateTime?

  printable Boolean? @default(true)

  patientCopy PrescriptionPatientCopy?
  clinicCopy  PrescriptionClinicCopy?

  drugInteractions PrescriptionDrugInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, prescriptionCode])
  @@index([tenantId, patientId, issuedAt])
  @@index([tenantId, visitId])
  @@index([tenantId, prescribedById])
  @@index([tenantId, status])
  @@index([tenantId, prescribedById, issuedAt])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, patientId, status])
}

model PrescriptionMedication {
  id                  String    @id @default(uuid()) @db.Uuid
  prescriptionId      String    @db.Uuid
  prescription        Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId          String?   @db.Uuid
  medicine            Medicine? @relation(fields: [medicineId], references: [id])
  name                String
  genericName         String?
  form                String?
  strength            String?
  dose                String?
  route               String?
  frequency           String?
  durationDays        Int?
  quantity            Int?
  instructions        String?
  // calculatedDosage (flattened - fixed shape nested struct)
  calcDose            String?
  calcFrequency       String?
  calcTotalDailyDose  String?
  calcInstructions    String?

  @@index([prescriptionId])
  @@index([medicineId])
}

model PrescriptionPharmacyDispense {
  id                String        @id @default(uuid()) @db.Uuid
  prescriptionId    String        @db.Uuid
  prescription      Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacyId        String?
  pharmacyName      String?
  dispensedAt       DateTime?
  dispensedBy       String?
  quantityDispensed Int?
  notes             String?
  trackingNumber    String?

  @@index([prescriptionId])
}

// copies.patientCopy (flattened embedded object) -> own 1:1 table so printedBy keeps a real FK
model PrescriptionPatientCopy {
  id               String       @id @default(uuid()) @db.Uuid
  prescriptionId   String       @unique @db.Uuid
  prescription     Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  printedAt        DateTime?
  printedById      String?      @db.Uuid
  printedBy        User?        @relation("PrescriptionCopyPrintedBy", fields: [printedById], references: [id])
  digitalCopySent  Boolean?     @default(false)
  sentAt           DateTime?

  @@index([printedById])
}

// copies.clinicCopy (flattened embedded object) -> own 1:1 table so archivedBy keeps a real FK
model PrescriptionClinicCopy {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @unique @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  archivedAt     DateTime?
  archivedById   String?      @db.Uuid
  archivedBy     User?        @relation("PrescriptionCopyArchivedBy", fields: [archivedById], references: [id])
  location       String?

  @@index([archivedById])
}

model PrescriptionDrugInteraction {
  id             String                   @id @default(uuid()) @db.Uuid
  prescriptionId String                   @db.Uuid
  prescription   Prescription             @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication1    String
  medication2    String
  severity       DrugInteractionSeverity
  description    String
  recommendation String?
  checkedAt      DateTime                 @default(now())

  @@index([prescriptionId])
}

// ============================================================================
// LabResult
// ============================================================================

model LabResult {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  visitId String? @db.Uuid
  visit   Visit?  @relation(fields: [visitId], references: [id])

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  orderedById String? @db.Uuid
  orderedBy   User?   @relation("LabResultOrderedBy", fields: [orderedById], references: [id])

  orderDate   DateTime @default(now())
  requestCode String?

  // request (flattened - fixed shape struct, embedded 1:1)
  requestTestType             String
  requestTestCode              String?
  requestDescription            String?
  requestUrgency                 LabUrgency? @default(routine)
  requestSpecialInstructions      String?
  requestFastingRequired           Boolean?    @default(false)
  requestPreparationNotes           String?

  // thirdPartyLab (flattened - fixed shape struct, embedded 1:1, optional)
  thirdPartyLabName              String?
  thirdPartyLabId                 String?
  thirdPartyLabCode                String?
  thirdPartyIntegrationType         LabIntegrationType?
  thirdPartyApiEndpoint              String?
  thirdPartyApiKey                    String? // TODO: encrypt at rest — was plaintext in Mongoose too
  thirdPartyExternalRequestId          String?
  thirdPartyExternalResultId            String?
  thirdPartyStatus                       LabThirdPartyStatus?
  thirdPartySentAt                        DateTime?
  thirdPartyReceivedAt                     DateTime?
  thirdPartyErrorMessage                    String?

  // results / referenceRanges: genuinely dynamic structured data (e.g. { hb: 13.2, wbc: 6.5 }) -> Json
  results         Json?
  resultDate      DateTime?
  interpretation  String?
  referenceRanges Json?
  // abnormalFlags: Map<string, 'high'|'low'|'normal'> — dynamic keys -> Json
  abnormalFlags   Json?

  status LabResultStatus @default(ordered)

  attachments LabResultAttachment[]

  reviewedById String? @db.Uuid
  reviewedBy   User?   @relation("LabResultReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  notificationSent      Boolean?            @default(false)
  notificationSentAt    DateTime?
  notificationMethod    NotificationMethod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@unique([tenantId, requestCode])
  @@index([tenantId, patientId, orderDate])
  @@index([tenantId, visitId])
  @@index([tenantId, orderedById])
  @@index([tenantId, reviewedById])
  @@index([tenantId, status])
  @@index([tenantId, orderedById, orderDate])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, patientId, status])
}

model LabResultAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  labResultId  String    @db.Uuid
  labResult    LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String?
  size         Int?
  url          String?
  gridFsId     String?
  uploadedById String?   @db.Uuid
  uploadDate   DateTime  @default(now())
  notes        String?

  @@index([labResultId])
}

// ============================================================================
// Imaging
// ============================================================================

model Imaging {
