// ============================================================================
// Tenant
// ============================================================================

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  subdomain   String       @unique
  displayName String?
  email       String?
  phone       String?

  // address (flattened - fixed shape struct, not independently queried)
  addressStreet  String?
  addressCity    String?
  addressState   String?
  addressZipCode String?
  addressCountry String?

  // settings (flattened - fixed shape struct)
  settingsTimezone              String? @default("UTC")
  settingsCurrency              String? @default("PHP")
  settingsCurrencySymbol        String?
  settingsCurrencyPosition      CurrencyPosition?
  settingsDateFormat            String? @default("MM/DD/YYYY")
  settingsTimeFormat            TimeFormat?
  settingsLanguage              Language?
  settingsNumberDecimalSep      String?
  settingsNumberThousandsSep    String?
  settingsNumberDecimalPlaces   Int?
  settingsLogo                  String?
  settingsPrimaryColor          String?
  settingsSecondaryColor        String?

  status TenantStatus @default(active)

  // subscription (flattened - fixed shape struct)
  subscriptionPlan                String?
  subscriptionStatus              SubscriptionStatus? @default(active)
  subscriptionBillingCycle        BillingCycle?        @default(monthly)
  subscriptionExpiresAt           DateTime?
  subscriptionRenewalAt           DateTime?
  subscriptionPaypalOrderId       String?
  subscriptionPaypalSubscriptionId String?
  // processedWebhookIds: small primitive array -> native Postgres array
  subscriptionProcessedWebhookIds String[] @default([])

  paymentHistory TenantPaymentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                    Role[]
  permissions               Permission[]
  admins                    Admin[]
  doctors                   Doctor[]
  nurses                    Nurse[]
  receptionists              Receptionist[]
  accountants                Accountant[]
  medicalRepresentativeTenants MedicalRepresentativeTenant[]
  staff                      Staff[]
  users                      User[]
  patientTenants              PatientTenant[]
  patientNotes                PatientNote[]
  rooms                       Room[]
  services                    Service[]
  medicines                   Medicine[]
  products                    Product[]
  inventoryItems               InventoryItem[]
  queues                       Queue[]
  appointments                 Appointment[]
  visits                       Visit[]
  prescriptions                 Prescription[]
  labResults                    LabResult[]
  imagings                      Imaging[]
  procedures                    Procedure[]
  invoices                      Invoice[]
  referrals                     Referral[]
  memberships                   Membership[]
  documents                     Document[]
  notifications                 Notification[]
  pushSubscriptions              PushSubscription[]
  auditLogs                      AuditLog[]
  supportRequests                 SupportRequest[]
  backupRecords                   BackupRecord[]
  paypalOrders                     PaypalOrder[]
  surveys                          SurveyResponse[]
  settings                          Settings?
  medicalRepresentativeVisits        MedicalRepresentativeVisit[]

  @@index([status])
  @@index([subscriptionStatus])
  @@index([subscriptionPaypalOrderId])
  @@index([createdAt])
}

// Multiple partial payments over time recorded historically -> child table
model TenantPaymentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId String
  orderId       String
  amount        Float
  currency      String   @default("USD")
  payerEmail    String?
  plan          String
  billingCycle  BillingCycle @default(monthly)
  status        PaymentHistoryStatus @default(completed)
  paidAt        DateTime @default(now())

  @@index([tenantId])
}

// ============================================================================
// Attachment (helper — see MIGRATION_NOTES: embedded per-parent, not a shared table)
// ============================================================================
// Attachment is a small, fixed-shape embedded subdocument used on Patient,
// Visit, LabResult, Imaging, Procedure. Each parent gets its own attachment
// child table (PatientAttachment, VisitAttachment, LabResultAttachment,
// ImagingAttachment, ProcedureAttachment) rather than one shared polymorphic
// table, to keep real FK relations (see MIGRATION_NOTES.md).

// ============================================================================
// Role / Permission
// ============================================================================

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        RoleName
  displayName String
  description String?
  level       Int?
  isActive    Boolean   @default(true)

  defaultPermissions RoleDefaultPermission[]
  permissions        Permission[]             @relation("RolePermissions")
  users              User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, name, isActive])
  @@index([tenantId, level])
  @@index([tenantId, isActive])
}

// defaultPermissions: array of {resource, actions[]} objects, independently meaningful -> child table
model RoleDefaultPermission {
  id       String   @id @default(uuid()) @db.Uuid
  roleId   String   @db.Uuid
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  // actions: small primitive string array -> native Postgres array
  actions  String[] @default([])

  @@index([roleId])
}

model Permission {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String?  @db.Uuid
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // explicit many-to-many via Prisma implicit relation table on Role<->Permission
  roles Role[] @relation("RolePermissions")

  resource String
  actions  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, resource])
  @@index([tenantId, resource])
}

// ============================================================================
// Profile models: Staff / Admin / Doctor / Nurse / Receptionist / Accountant /
// MedicalRepresentative
// ============================================================================

model Staff {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String

  staffType  String?
  employeeId String?
  department String?
  position   String?
  hireDate   DateTime?
  address    String?

  // emergencyContact (flattened - fixed shape struct)
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  status StaffStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("UserStaffInfo")

  @@unique([tenantId, email])
  @@index([tenantId, employeeId])
  @@index([tenantId, department])
  @@index([tenantId, position])
  @@index([tenantId, status])
}

model Admin {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  title       String?
  department  String?
  accessLevel ProfileAccessLevel @default(full)

  internalNotes AdminInternalNote[]

  bio    String?
  status RecordStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, department, status])
  @@index([tenantId, accessLevel, status])
}

model AdminInternalNote {
  id          String   @id @default(uuid()) @db.Uuid
  adminId     String   @db.Uuid
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  note        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  isImportant Boolean  @default(false)

  @@index([adminId])
}

model Doctor {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  email            String
  phone            String
  specializationId String @db.Uuid
  specialization   Specialization @relation(fields: [specializationId], references: [id])
  licenseNumber    String
  ptr              String? @default("")

  schedule               DoctorScheduleSlot[]
  availabilityOverrides  DoctorAvailabilityOverride[]
  internalNotes          DoctorInternalNote[]

  // performanceMetrics (flattened - fixed shape struct)
  perfTotalAppointments     Int      @default(0)
  perfCompletedAppointments Int      @default(0)
  perfCancelledAppointments Int      @default(0)
  perfNoShowAppointments    Int      @default(0)
  perfAverageRating         Float?
  perfLastUpdated           DateTime?

  title          String?
  // qualifications: small primitive array -> native array
  qualifications String[] @default([])
  bio            String?
  department     String?
  status         StaffStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?
  queues              Queue[]
  appointments        Appointment[]
  invoicesAsPFDoctor  Invoice[] @relation("InvoiceProfessionalFeeDoctor")
  referralsReferring  Referral[] @relation("ReferralReferringDoctor")
  referralsReceiving  Referral[] @relation("ReferralReceivingDoctor")

  @@unique([tenantId, email])
  @@unique([tenantId, licenseNumber])
  @@index([tenantId, ptr])
  @@index([tenantId, specializationId, status])
  @@index([tenantId, department, status])
  @@index([tenantId, status])
}

