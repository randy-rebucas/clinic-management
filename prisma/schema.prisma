// ============================================================================
// Settings
// ============================================================================

model Settings {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @unique @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clinicName    String @default("MyClinicSoft")
  clinicAddress String @default("")
  clinicPhone   String @default("")
  clinicEmail   String @default("")
  clinicWebsite String? @default("")
  taxId         String? @default("")
  licenseNumber String? @default("")
  ptr           String? @default("")

  businessHours SettingsBusinessHours[]

  // appointmentSettings (flattened - fixed shape struct)
  apptDefaultDuration        Int      @default(30)
  // reminderHoursBefore: small primitive number array -> native array
  apptReminderHoursBefore    Int[]    @default([24, 2])
  apptAllowOnlineBooking      Boolean  @default(true)
  apptRequireConfirmation      Boolean  @default(false)
  apptMaxAdvanceBookingDays     Int      @default(90)
  apptMinAdvanceBookingHours     Int      @default(2)

  // communicationSettings (flattened - fixed shape struct)
  commSmsEnabled               Boolean @default(false)
  commEmailEnabled              Boolean @default(false)
  commAppointmentReminders       Boolean @default(true)
  commLabResultNotifications      Boolean @default(true)
  commInvoiceReminders             Boolean @default(true)

  // billingSettings (flattened - fixed shape struct)
  billingCurrency         String  @default("PHP")
  billingTaxRate           Float   @default(0)
  billingPaymentTerms        Int     @default(30)
  billingLateFeePercentage     Float   @default(0)
  billingInvoicePrefix           String  @default("INV")
  billingAllowPartialPayments      Boolean @default(true)

  // queueSettings (flattened - fixed shape struct)
  queueEnable                  Boolean @default(true)
  queueAutoAssignRooms           Boolean @default(false)
  queueEstimatedWaitTimeMinutes    Int     @default(15)
  queueDisplayPublicly               Boolean @default(false)

  // generalSettings (flattened - fixed shape struct)
  generalTimezone               String     @default("UTC")
  generalDateFormat               String     @default("MM/DD/YYYY")
  generalTimeFormat                 TimeFormat @default(h12)
  generalItemsPerPage                 Int        @default(20)
  generalEnableAuditLog                 Boolean    @default(true)
  generalSessionTimeoutMinutes            Int        @default(480)

  // integrationSettings (flattened - fixed shape struct)
  integrationCloudinaryEnabled Boolean @default(false)
  integrationTwilioEnabled      Boolean @default(false)
  integrationSmtpEnabled          Boolean @default(false)

  // automationSettings: large fixed-shape boolean struct — flattened as columns,
  // all default true to match Mongoose defaults (see MIGRATION_NOTES.md for the
  // full field-by-field mapping decision)
  autoInvoiceGeneration          Boolean @default(true)
  autoPaymentReminders            Boolean @default(true)
  autoLowStockAlerts                Boolean @default(true)
  autoLabNotifications                Boolean @default(true)
  autoExpiryMonitoring                  Boolean @default(true)
  autoAppointmentConfirmation             Boolean @default(true)
  autoPrescriptionRefills                   Boolean @default(true)
  autoFollowupScheduling                      Boolean @default(true)
  autoDailyReports                              Boolean @default(true)
  autoWelcomeMessages                             Boolean @default(true)
  autoVisitSummaries                                Boolean @default(true)
  autoNoShowHandling                                  Boolean @default(true)
  autoWaitlistManagement                                Boolean @default(true)
  autoBirthdayGreetings                                   Boolean @default(true)
  autoHealthReminders                                       Boolean @default(true)
  autoFeedbackCollection                                      Boolean @default(true)
  autoRecurringAppointments                                     Boolean @default(true)
  autoMedicationAdherence                                         Boolean @default(true)
  autoBroadcastMessaging                                            Boolean @default(true)
  autoPeriodicReports                                                 Boolean @default(true)
  autoStaffPerformanceReports                                           Boolean @default(true)
  autoInsuranceVerification                                               Boolean @default(true)
  autoQueueOptimization                                                     Boolean @default(true)
  autoDataRetention                                                           Boolean @default(true)
  autoSmartAssignment                                                           Boolean @default(true)
  autoInventoryReordering                                                         Boolean @default(true)
  autoPrescriptionExpiryWarnings                                                    Boolean @default(true)
  autoDocumentExpiryTracking                                                          Boolean @default(true)
  autoCancellationPolicies                                                              Boolean @default(true)

  // displaySettings (flattened - fixed shape struct)
  displayTheme             SettingsTheme @default(light)
  displaySidebarCollapsed    Boolean       @default(true)
  displayShowNotifications     Boolean       @default(true)

  prescriptionDigitalSignatureEnabled Boolean? @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SettingsBusinessHours {
  id         String        @id @default(uuid()) @db.Uuid
  settingsId String        @db.Uuid
  settings   Settings      @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  day        DayOfWeekName
  open       String
  close      String
  closed     Boolean       @default(false)

  @@index([settingsId])
}

// ============================================================================
// MedicalRepresentativeVisit
// ============================================================================

model MedicalRepresentativeVisit {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  medicalRepresentativeId String?                @db.Uuid
  medicalRepresentative   MedicalRepresentative? @relation(fields: [medicalRepresentativeId], references: [id])

  clinicName     String
  clinicLocation String
  purpose        String
  date           DateTime
  time           String
  duration       Int      @default(60)
