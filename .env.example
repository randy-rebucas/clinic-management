# ──────────────────────────────────────────────────────────────────────────────
# Clinic Management — Environment Variables
# Copy this file to .env.local and fill in real values before running.
# NEVER commit .env.local or any file with real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/clinic?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/clinic-management
MONGODB_URI=

# JWT session secret — min 32 chars
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Cron job bearer token — min 32 chars
# Generate: openssl rand -base64 32
CRON_SECRET=

# AES-256 encryption key — exactly 64 hex chars (32 bytes)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Multi-Tenancy ─────────────────────────────────────────────────────────────

# Apex domain used to extract subdomains for tenant identification
# Example: myclinic.com  (tenant subdomains: clinic1.myclinic.com)
ROOT_DOMAIN=

# Cookie domain for cross-subdomain session sharing (include leading dot)
# Example: .myclinic.com
# Leave empty for single-domain or local development
COOKIE_DOMAIN=

# ── Payments (PayPal) ─────────────────────────────────────────────────────────

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID from PayPal developer dashboard — required in production
PAYPAL_WEBHOOK_ID=

# ── SMS (Twilio) ───────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format: +1234567890
TWILIO_PHONE_NUMBER=

# ── Email (SMTP / Nodemailer) ─────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if not set
SMTP_FROM=

# ── File Storage (Cloudinary) ─────────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Push Notifications (Web Push / VAPID) ────────────────────────────────────

# Generate keypair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────

# DSN from your Sentry project settings
# Install package first: npm install @sentry/nextjs
SENTRY_DSN=

# ── Lab Integration ───────────────────────────────────────────────────────────

# HMAC-SHA256 secret for verifying third-party lab webhooks
# Generate: openssl rand -base64 32
# Required if receiving lab results via webhook
LAB_WEBHOOK_SECRET=

# ── Install / Bootstrap ───────────────────────────────────────────────────────

# Required to access /api/install/* during initial setup
# Remove from environment immediately after first deploy
# Generate: openssl rand -base64 32
INSTALL_SECRET=

# ── Application ───────────────────────────────────────────────────────────────

# Public-facing app URL (used in FHIR resources, sitemaps, emails)
NEXT_PUBLIC_APP_URL=https://myclinic.com

# Application display name
NEXT_PUBLIC_APP_NAME=Clinic Management

# RxNorm/RxNav drug interaction API base URL
# Defaults to NLM public API — override only if using a self-hosted instance
# RXNAV_API_URL=https://rxnav.nlm.nih.gov

# ── CORS (Third-party / Mobile Access) ───────────────────────────────────────

# Comma-separated list of allowed cross-origin caller domains
# Example: https://myapp.example.com,https://mobile.example.com
# All localhost origins are automatically allowed in development
CORS_ALLOWED_ORIGINS=
