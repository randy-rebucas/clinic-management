// ============================================================================
// Clinic Management — Prisma Schema (Phase 1: MongoDB/Mongoose -> PostgreSQL)
//
// Translated from 39 Mongoose models in models/*.ts.
// See prisma/MIGRATION_NOTES.md for every judgment call made during
// translation — review before Phase 2 (data migration scripts).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

