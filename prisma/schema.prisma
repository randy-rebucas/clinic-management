  outcome String?

  attachments ProcedureAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, patientId, date])
  @@index([tenantId, visitId])
  @@index([tenantId, performedById])
  @@index([tenantId, performedById, date])
  @@index([tenantId, type, date])
}

model ProcedureAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  procedureId  String    @db.Uuid
  procedure    Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String?
  size         Int?
  url          String?
  gridFsId     String?
  uploadedById String?   @db.Uuid
  uploadDate   DateTime  @default(now())
  notes        String?

  @@index([procedureId])
}

// ============================================================================
// Invoice (+ InvoiceLineItem, + InvoicePayment)
// ============================================================================

model Invoice {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  visitId String? @db.Uuid
  visit   Visit?  @relation(fields: [visitId], references: [id])

  invoiceNumber String

  lineItems InvoiceLineItem[]

  subtotal Float?

  professionalFee       Float?  @default(0)
  professionalFeeDoctorId String? @db.Uuid
  professionalFeeDoctor   Doctor? @relation("InvoiceProfessionalFeeDoctor", fields: [professionalFeeDoctorId], references: [id])
  professionalFeeType      InvoiceProfessionalFeeType?
  professionalFeeNotes      String?

  discounts InvoiceDiscount[]

  tax   Float?
  total Float?

  payments InvoicePayment[]

  // insurance (flattened - fixed shape struct, embedded 1:1)
  insuranceProvider       String?
  insurancePolicyNumber    String?
  insuranceMemberId         String?
  insuranceCoverageType       InsuranceCoverageType?
  insuranceCoverageAmount      Float?
  insuranceClaimNumber          String?
  insuranceStatus                 InsuranceClaimStatus?
  insuranceNotes                    String?

  outstandingBalance Float?
  totalPaid          Float?
  status             InvoiceStatus @default(unpaid)

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  createdBy   User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, visitId])
  @@index([tenantId, status])
  @@index([tenantId, invoiceNumber])
  @@index([tenantId, createdById])
  @@index([tenantId, createdById, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, patientId, status])
  @@index([tenantId, insuranceStatus])
  @@index([tenantId, createdAt, status])
  @@index([tenantId, visitId, status])
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?  @db.Uuid
  service     Service? @relation(fields: [serviceId], references: [id])
  code        String?
  description String?
  category    String?
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)

  @@index([invoiceId])
}

// discounts[]: multiple discounts can be applied over time on one invoice -> child table
model InvoiceDiscount {
  id          String       @id @default(uuid()) @db.Uuid
  invoiceId   String       @db.Uuid
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        DiscountType
  reason      String?
  percentage  Float?
  amount      Float
  appliedById String?      @db.Uuid
  appliedBy   User?        @relation("InvoiceDiscountAppliedBy", fields: [appliedById], references: [id])

  @@index([invoiceId])
}

// payments[]: Mongoose schema allows multiple payments over time (partial payments) -> child table
model InvoicePayment {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceId     String        @db.Uuid
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  amount        Float
  date          DateTime      @default(now())
  receiptNo     String?
  referenceNo   String?
  processedById String?       @db.Uuid
  processedBy   User?         @relation("InvoicePaymentProcessedBy", fields: [processedById], references: [id])
  notes         String?

  @@index([invoiceId])
}

// ============================================================================
// Referral
// ============================================================================

model Referral {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  referralCode String?
  type         ReferralType

  referringDoctorId String? @db.Uuid
  referringDoctor   Doctor? @relation("ReferralReferringDoctor", fields: [referringDoctorId], references: [id])

  referringPatientId String?  @db.Uuid
  referringPatient   Patient? @relation("ReferralReferringPatient", fields: [referringPatientId], references: [id])

  referringClinic String?

  // referringContact (flattened - fixed shape struct)
  referringContactName  String?
  referringContactPhone String?
  referringContactEmail String?

  receivingDoctorId String? @db.Uuid
  receivingDoctor   Doctor? @relation("ReferralReceivingDoctor", fields: [receivingDoctorId], references: [id])

  receivingClinic String?

  patientId String  @db.Uuid
  patient   Patient @relation("ReferralPatientSubject", fields: [patientId], references: [id])

  reason    String
  urgency   LabUrgency @default(routine)
  specialty String?
  notes     String?

  chiefComplaint  String?
  diagnosis       String?
  relevantHistory String?
  medications     String[] @default([])

  attachments ReferralAttachment[]

  status ReferralStatus @default(pending)

  referredDate   DateTime  @default(now())
  acceptedDate   DateTime?
  completedDate  DateTime?
  declinedDate   DateTime?
  declinedReason String?

  visitId       String?      @db.Uuid
  visit         Visit?       @relation(fields: [visitId], references: [id])
  appointmentId String?      @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?
  followUpNotes    String?

  // feedback (flattened - fixed shape struct, embedded 1:1, optional)
  feedbackRating         Int?
  feedbackComments        String?
  feedbackSubmittedById     String?   @db.Uuid
  feedbackSubmittedBy       User?     @relation("ReferralFeedbackSubmittedBy", fields: [feedbackSubmittedById], references: [id])
  feedbackSubmittedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, referralCode])
  @@index([tenantId, referringDoctorId, status])
  @@index([tenantId, receivingDoctorId, status])
  @@index([tenantId, patientId, status])
  @@index([tenantId, status, referredDate])
  @@index([tenantId, type, status])
  @@index([tenantId, feedbackSubmittedById])
}

model ReferralAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  referralId String   @db.Uuid
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  filename   String
  url        String
  uploadDate DateTime @default(now())

  @@index([referralId])
}

// ============================================================================
// Membership (+ MembershipTransaction)
// ============================================================================

model Membership {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String  @unique @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  membershipNumber String

  tier   MembershipTier   @default(bronze)
  status MembershipStatus @default(active)

  points               Int @default(0)
  totalPointsEarned    Int @default(0)
  totalPointsRedeemed  Int @default(0)

  joinDate   DateTime @default(now())
  expiryDate DateTime?
  renewalDate DateTime?

  discountPercentage Float    @default(0)
  benefits           String[] @default([])

  // self-relation: referredBy lives on Membership in the Mongoose model (Membership.referredBy -> Patient)
  referredById String?  @db.Uuid
  referredBy   Patient? @relation("MembershipReferredBy", fields: [referredById], references: [id])
  // NOTE: Mongoose Membership.referrals (Patient[]) is the inverse of referredBy but points at
  // Patient, not other Memberships — modeled here as informational only; the actual patients
  // referred are queryable via Patient.memberReferralsMade using referredById. No separate
  // array column is created (see MIGRATION_NOTES.md).

  transactions MembershipTransaction[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, membershipNumber])
  @@index([tenantId, tier, status])
  @@index([tenantId, points])
  @@index([tenantId, expiryDate])
  @@index([referredById])
}

model MembershipTransaction {
  id           String                       @id @default(uuid()) @db.Uuid
  membershipId String                       @db.Uuid
  membership   Membership                   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type         MembershipTransactionType
  points       Int
  description  String
  // relatedEntity (flattened - fixed shape struct; id is informational, no FK since it's polymorphic across Visit/Appointment/Invoice)
  relatedEntityType MembershipRelatedEntityType?
  relatedEntityId   String?                       @db.Uuid
  createdAt         DateTime                       @default(now())

  @@index([membershipId])
}

// ============================================================================
// Document (polymorphic optional refs -> nullable FK columns)
// ============================================================================

model Document {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentCode String
  title        String
  description  String?
  category     DocumentCategory
  documentType DocumentType

  filename         String
  originalFilename String
  contentType      String
  size             Int
  url              String
  thumbnailUrl     String?

  // Polymorphic optional relations — app layer must enforce "at most one set" (no CHECK
  // constraint added here; see MIGRATION_NOTES.md)
  patientId     String?      @db.Uuid
  patient       Patient?     @relation(fields: [patientId], references: [id])
  visitId       String?      @db.Uuid
  visit         Visit?       @relation(fields: [visitId], references: [id])
  appointmentId String?      @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  labResultId   String?      @db.Uuid
  labResult     LabResult?   @relation(fields: [labResultId], references: [id])
  invoiceId     String?      @db.Uuid
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])

  tags       String[] @default([])
  scanned    Boolean? @default(false)
  ocrText    String?
  expiryDate DateTime?
  metadata   Json? // genuinely dynamic key-value metadata (e.g. cloudinaryPublicId)

  // referral (flattened - fixed shape struct, embedded 1:1, optional)
  referralReferringDoctor String?
  referralReferringClinic String?
  referralDate            DateTime?
  referralReason          String?

  // imaging (flattened - fixed shape struct, embedded 1:1, optional)
  imagingModality    String?
  imagingBodyPart    String?
  imagingStudyDate   DateTime?
  imagingRadiologist String?

  // medicalCertificate (flattened - fixed shape struct, embedded 1:1, optional)
  medCertIssueDate    DateTime?
  medCertValidUntil   DateTime?
  medCertPurpose      String?
  medCertRestrictions String?

  // labResultMetadata (flattened - fixed shape struct, embedded 1:1, optional)
  labMetaTestType String?
  labMetaTestDate DateTime?
  labMetaLabName  String?

  uploadedById String @db.Uuid
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadDate   DateTime @default(now())

  lastModifiedById String?   @db.Uuid
  lastModifiedBy   User?     @relation("DocumentLastModifiedBy", fields: [lastModifiedById], references: [id])
  lastModifiedDate DateTime?

  status          DocumentStatus @default(active)
  isConfidential  Boolean?       @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, documentCode])
  @@index([tenantId, patientId, category, status])
  @@index([tenantId, category, status])
  @@index([tenantId, tags])
  @@index([tenantId, uploadDate])
  @@index([tenantId, expiryDate])
  @@index([tenantId, uploadedById])
  @@index([tenantId, uploadedById, uploadDate])
  @@index([tenantId, lastModifiedById])
  @@index([tenantId, visitId, category])
  @@index([tenantId, appointmentId, category])
}

// ============================================================================
// Notification
// ============================================================================

model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  type     NotificationType
  priority NotificationPriority @default(normal)
  title    String
  message  String

  // relatedEntity (flattened - fixed shape struct; id is informational/polymorphic, no FK)
  relatedEntityType NotificationRelatedEntityType?
  relatedEntityId   String?                          @db.Uuid

  actionUrl String?
  read      Boolean  @default(false)
  readAt    DateTime?

  metadata  Json? // genuinely dynamic
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, read, createdAt])
  @@index([tenantId, userId, type, read])
  @@index([tenantId, expiresAt])
}

// ============================================================================
// PushSubscription
// ============================================================================

model PushSubscription {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  endpoint String @unique

  // keys (flattened - fixed shape struct)
  keysP256dh String
  keysAuth   String

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId])
}

// ============================================================================
// AuditLog (+ Change[] child table)
// ============================================================================

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id])
  userEmail String?
  userRole  String?

  action     AuditAction
  resource   AuditResource
  resourceId String?       @db.Uuid

  ipAddress     String?
  userAgent     String?
  requestMethod String?
  requestPath   String?

  changes AuditLogChange[]

  description String?
  metadata    Json? // genuinely dynamic context data

  success      Boolean @default(true)
  errorMessage String?

  isSensitive  Boolean? @default(false)
  dataSubjectId String? @db.Uuid
  dataSubject   Patient? @relation(fields: [dataSubjectId], references: [id])

  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tenantId, userId, timestamp])
  @@index([tenantId, resource, resourceId, timestamp])
  @@index([tenantId, action, timestamp])
  @@index([tenantId, dataSubjectId, timestamp])
  @@index([tenantId, isSensitive, timestamp])
  @@index([tenantId, timestamp])
  @@index([userEmail])
  @@index([userRole])
}

model AuditLogChange {
  id         String   @id @default(uuid()) @db.Uuid
  auditLogId String   @db.Uuid
  auditLog   AuditLog @relation(fields: [auditLogId], references: [id], onDelete: Cascade)
  field      String
  // oldValue/newValue: genuinely dynamic (any type in Mongoose) -> Json
  oldValue   Json?
  newValue   Json?

  @@index([auditLogId])
}

// ============================================================================
// SupportRequest
// ============================================================================

model SupportRequest {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  email    String
  subject  String
  category SupportCategory @default(general)
  message  String
  status   SupportStatus   @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, email, createdAt])
}

// ============================================================================
// BackupRecord
// ============================================================================

model BackupRecord {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById    String  @db.Uuid
  createdBy      User    @relation("BackupCreatedBy", fields: [createdById], references: [id])
  createdByEmail String?

  label       String?
  status      BackupStatus @default(pending)
  collections String[]     @default([])

  totalDocuments Int   @default(0)
  sizeBytes      Int   @default(0)
  version        String @default("1.0")

  // data: Record<string, unknown[]> — inherently dynamic dump of arbitrary collection data -> Json
  data Json

  errorMessage String?

  restoredAt   DateTime?
  restoredById String?   @db.Uuid
  restoredBy   User?     @relation("BackupRestoredBy", fields: [restoredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
}

