  internalNotes         MedicalRepresentativeInternalNote[]

  perfTotalVisits     Int       @default(0)
  perfCompletedVisits Int       @default(0)
  perfCancelledVisits Int       @default(0)
  perfLastUpdated     DateTime?

  title  String?
  bio    String?
  status StaffStatus @default(inactive)

  isActivated      Boolean   @default(false)
  activationDate   DateTime?
  paymentStatus    MedRepPaymentStatus @default(pending)
  paymentDate      DateTime?
  paymentAmount    Float?
  paymentMethod    String?
  paymentReference String?
  lastLogin        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User?
  productsRepped     Product[]
  visits             MedicalRepresentativeVisit[]

  @@index([company, status])
  @@index([status])
  @@index([createdAt])
}

// PatientTenant-style junction table (see agreed pattern for many-to-many tenant refs)
model MedicalRepresentativeTenant {
  medicalRepresentativeId String                 @db.Uuid
  medicalRepresentative   MedicalRepresentative  @relation(fields: [medicalRepresentativeId], references: [id], onDelete: Cascade)
  tenantId                String                 @db.Uuid
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt               DateTime               @default(now())

  @@id([medicalRepresentativeId, tenantId])
  @@index([tenantId])
}

model MedicalRepresentativeAvailabilitySlot {
  id                      String                @id @default(uuid()) @db.Uuid
  medicalRepresentativeId String                @db.Uuid
  medicalRepresentative   MedicalRepresentative @relation(fields: [medicalRepresentativeId], references: [id], onDelete: Cascade)
  dayOfWeek               Int
  startTime               String
  endTime                 String
  isAvailable             Boolean               @default(true)

  @@index([medicalRepresentativeId])
}

model MedicalRepresentativeAvailabilityOverride {
  id                      String                @id @default(uuid()) @db.Uuid
  medicalRepresentativeId String                @db.Uuid
  medicalRepresentative   MedicalRepresentative @relation(fields: [medicalRepresentativeId], references: [id], onDelete: Cascade)
  date                    DateTime
  isAvailable             Boolean
  startTime               String?
  endTime                 String?
  reason                  String?

  @@index([medicalRepresentativeId])
}

model MedicalRepresentativeInternalNote {
  id                      String                @id @default(uuid()) @db.Uuid
  medicalRepresentativeId String                @db.Uuid
  medicalRepresentative   MedicalRepresentative @relation(fields: [medicalRepresentativeId], references: [id], onDelete: Cascade)
  note                    String
  createdById             String?               @db.Uuid
  createdAt               DateTime              @default(now())
  isImportant             Boolean               @default(false)

  @@index([medicalRepresentativeId])
}

// ============================================================================
// User
// ============================================================================

model User {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  email    String
  password String
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  // DEPRECATED legacy staff link, kept for backward compatibility
  staffInfoId String? @db.Uuid
  staffInfo   Staff?  @relation("UserStaffInfo", fields: [staffInfoId], references: [id])

  permissions Permission[]

  // One-of profile refs — nullable unique FK columns, each with a real relation
  adminProfileId                 String? @unique @db.Uuid
  adminProfile                   Admin?  @relation(fields: [adminProfileId], references: [id])
  doctorProfileId                String? @unique @db.Uuid
  doctorProfile                  Doctor? @relation(fields: [doctorProfileId], references: [id])
  nurseProfileId                 String? @unique @db.Uuid
  nurseProfile                   Nurse?  @relation(fields: [nurseProfileId], references: [id])
  receptionistProfileId          String? @unique @db.Uuid
  receptionistProfile            Receptionist? @relation(fields: [receptionistProfileId], references: [id])
  accountantProfileId            String? @unique @db.Uuid
  accountantProfile               Accountant?  @relation(fields: [accountantProfileId], references: [id])
  medicalRepresentativeProfileId  String? @unique @db.Uuid
  medicalRepresentativeProfile     MedicalRepresentative? @relation(fields: [medicalRepresentativeProfileId], references: [id])

  status RecordStatus @default(active)

  lastLogin   DateTime?
  totpSecret  String? // select:false in Mongoose — app layer must exclude by default; see MIGRATION_NOTES
  totpEnabled Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productsCreated             Product[]
  inventoryRestocks           InventoryItem[] @relation("InventoryLastRestockedBy")
  appointmentsAsProvider      Appointment[]   @relation("AppointmentProvider")
  appointmentsCreated         Appointment[]   @relation("AppointmentCreatedBy")
  visitsAsProvider            Visit[]         @relation("VisitProvider")
  visitDigitalSignatures      VisitDigitalSignature[]
  prescriptionsPrescribed     Prescription[]  @relation("PrescriptionPrescribedBy")
  prescriptionCopiesPrinted   PrescriptionPatientCopy[]  @relation("PrescriptionCopyPrintedBy")
  prescriptionCopiesArchived  PrescriptionClinicCopy[]   @relation("PrescriptionCopyArchivedBy")
  labResultsOrdered           LabResult[]     @relation("LabResultOrderedBy")
  labResultsReviewed          LabResult[]     @relation("LabResultReviewedBy")
  imagingsOrdered             Imaging[]       @relation("ImagingOrderedBy")
  imagingsReported            Imaging[]       @relation("ImagingReportedBy")
  proceduresPerformed         Procedure[]     @relation("ProcedurePerformedBy")
  invoicesCreated              Invoice[]       @relation("InvoiceCreatedBy")
  invoiceDiscountsApplied      InvoiceDiscount[] @relation("InvoiceDiscountAppliedBy")
  invoicePaymentsProcessed     InvoicePayment[] @relation("InvoicePaymentProcessedBy")
  referralFeedbackSubmitted    Referral[]      @relation("ReferralFeedbackSubmittedBy")
  documentsUploaded            Document[]      @relation("DocumentUploadedBy")
  documentsModified            Document[]      @relation("DocumentLastModifiedBy")
  notifications                 Notification[]
  pushSubscriptions              PushSubscription[]
  auditLogs                      AuditLog[]
  auditLogsRestored              BackupRecord[]  @relation("BackupRestoredBy")
  backupsCreated                 BackupRecord[]  @relation("BackupCreatedBy")
  supportRequests                 SupportRequest[]
  medicalRepresentativeVisits      MedicalRepresentativeVisit[]

  @@index([roleId, status])
  @@index([status])
  @@index([email, tenantId])
  @@index([tenantId, status])
  @@index([lastLogin])
  @@index([createdAt])
}

// ============================================================================
// Specialization
// ============================================================================

model Specialization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  category    String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]

  @@index([category, active])
}

// ============================================================================
// Patient (+ PatientTenant, + PatientAllergy)
// ============================================================================

model Patient {
  id String @id @default(uuid()) @db.Uuid

  tenants PatientTenant[]

  patientCode String?

  firstName   String
  middleName  String?
  lastName    String
  suffix      String?
  dateOfBirth DateTime
  sex         PatientSex
  civilStatus String?
  nationality String?
  occupation  String?

  email String?
  phone String

  // contacts (flattened - fixed shape struct, redundant with top-level fields)
  contactsPhone   String?
  contactsEmail   String?
  contactsAddress String?

  // address (flattened - fixed shape struct)
  addressStreet  String
  addressCity    String
  addressState   String
  addressZipCode String

  // emergencyContact (flattened - fixed shape struct)
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  emergencyContactRelation     String?

  // identifiers (mostly flattened; "other" is a genuine dynamic map -> Json)
  identifierPhilHealth String?
  identifierGovId      String?
  identifierOther      Json? // Map<string,string> in Mongoose — dynamic keys

  medicalHistory String? @default("")

  preExistingConditions PatientPreExistingCondition[]
  // allergies: mixed type (string | structured object), clinically important -> own child table (see MIGRATION_NOTES)
  allergies              PatientAllergy[]
  immunizations          PatientImmunization[]

  // socialHistory (flattened - fixed shape struct)
  socialHistorySmoker  SmokerStatus?  @default(unknown)
  socialHistoryAlcohol AlcoholStatus? @default(unknown)
  socialHistoryDrugs   DrugsStatus?   @default(unknown)
  socialHistoryNotes   String?

  // familyHistory: genuine dynamic map (e.g. { diabetes: 'father' }) -> Json
  familyHistory Json?

  // discountEligibility (flattened - fixed shape nested struct)
  pwdEligible                Boolean?
  pwdIdNumber                String?
  pwdExpiryDate               DateTime?
  seniorEligible               Boolean?
  seniorIdNumber                String?
  membershipDiscEligible          Boolean?
  membershipDiscType               String?
  membershipDiscNumber              String?
  membershipDiscExpiryDate           DateTime?
  membershipDiscPercentage            Float?

  password    String? // select:false in Mongoose — app layer must exclude by default
  otp         String? // select:false in Mongoose — app layer must exclude by default
  otpExpiry   DateTime?
  otpAttempts Int?      @default(0)

  // readNotificationIds: small primitive array -> native array
  readNotificationIds String[] @default([])

  active      Boolean  @default(true)
  attachments PatientAttachment[]

  tags String[] @default([])

  // segmentFlags (flattened - fixed shape struct)
  segFlagIsVIP                  Boolean? @default(false)
  segFlagIsHighRisk              Boolean? @default(false)
  segFlagIsHighUtilizer           Boolean? @default(false)
  segFlagHasRecurringNoShow        Boolean? @default(false)
  segFlagIsPendingVerification      Boolean? @default(false)
  segFlagHasOutstandingBalance       Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes                       PatientNote[]
  queues                       Queue[]
  appointments                  Appointment[]
  visits                         Visit[]
  prescriptions                   Prescription[]
  labResults                       LabResult[]
  imagings                          Imaging[]
  procedures                         Procedure[]
  invoices                            Invoice[]
  referralsAsSubject                   Referral[] @relation("ReferralPatientSubject")
  referralsAsReferringPatient           Referral[] @relation("ReferralReferringPatient")
  membership                             Membership?
  documents                                Document[]
  memberReferralsMade                       Membership[] @relation("MembershipReferredBy")
  surveyResponses                            SurveyResponse[]
  auditLogsAsDataSubject                      AuditLog[]

  // NOTE: patientCode uniqueness in Mongoose was via a compound tenantIds+patientCode
  // sparse index — but Patient.tenantIds is now a many-to-many relation (no single
  // tenantId column exists on Patient), so a per-tenant compound unique isn't directly
  // expressible here. patientCode is enforced as GLOBALLY unique instead; see
  // MIGRATION_NOTES.md for the tradeoff and app-level enforcement note.

  @@unique([patientCode])
  @@index([lastName, firstName])
  @@index([email])
  @@index([dateOfBirth])
  @@index([sex])
  @@index([active])
  @@index([identifierPhilHealth])
  @@index([identifierGovId])
  @@index([createdAt])
  @@index([segFlagIsVIP])
  @@index([segFlagIsHighRisk])
  @@index([segFlagIsHighUtilizer])
  @@index([segFlagHasOutstandingBalance])
}

model PatientTenant {
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([patientId, tenantId])
  @@index([tenantId])
}

model PatientPreExistingCondition {
  id             String          @id @default(uuid()) @db.Uuid
  patientId      String          @db.Uuid
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition      String
  diagnosisDate  DateTime?
  status         ConditionStatus @default(active)
  notes          String?

  @@index([patientId])
}

// allergies: Mongoose Mixed (string | {substance, reaction, severity}) — modeled as
// own child table with nullable structured columns; `rawText` holds the simple-string
// form when the source was just a plain string. See MIGRATION_NOTES.md.
model PatientAllergy {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rawText   String? // used when source Mongoose value was a plain string
  substance String?
  reaction  String?
  severity  String?

  @@index([patientId])
}

model PatientImmunization {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime
  batch     String?
  notes     String?

  @@index([patientId])
}

model PatientAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String?
  size          Int?
  url           String?
  gridFsId      String?
  uploadedById  String?  @db.Uuid
  uploadDate    DateTime @default(now())
  notes         String?

  @@index([patientId])
}

// ============================================================================
// PatientNote
// ============================================================================

model PatientNote {
  id String @id @default(uuid()) @db.Uuid

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // author (flattened - fixed shape struct, denormalized snapshot)
  authorUserId String
  authorName   String
  authorRole   String

  content    String
  visibility NoteVisibility @default(internal)
  priority   NotePriority?  @default(normal)
  tags       String[]       @default([])

  attachments PatientNoteAttachment[]

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([patientId, visibility])
  @@index([authorUserId, createdAt])
  @@index([tenantId])
}

model PatientNoteAttachment {
  id            String      @id @default(uuid()) @db.Uuid
  patientNoteId String      @db.Uuid
  patientNote   PatientNote @relation(fields: [patientNoteId], references: [id], onDelete: Cascade)
  url           String?
  name          String?
  type          String?
  uploadedAt    DateTime    @default(now())

  @@index([patientNoteId])
}

// ============================================================================
// Room
// ============================================================================

model Room {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  roomNumber String?
  floor      Int?
  building   String?
  roomType   RoomType   @default(consultation)
  capacity   Int?
  equipment  String[]   @default([])
  amenities  String[]   @default([])
  status     RoomStatus @default(available)
  notes      String?

  schedule              RoomScheduleSlot[]
  availabilityOverrides RoomAvailabilityOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queues       Queue[]

  @@unique([tenantId, name])
  @@index([tenantId, roomType, status])
  @@index([tenantId, status])
  @@index([tenantId, roomType])
}

model RoomScheduleSlot {
  id          String  @id @default(uuid()) @db.Uuid
  roomId      String  @db.Uuid
  room        Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)

  @@index([roomId])
}

model RoomAvailabilityOverride {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @db.Uuid
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date        DateTime
  isAvailable Boolean
  reason      String?

  @@index([roomId])
}

// ============================================================================
// Service
// ============================================================================

model Service {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code           String
  name           String
  description    String?
  category       ServiceCategory
  type           String?
  unitPrice      Float
  unit           String  @default("per service")
  duration       Int?
  requiresDoctor Boolean @default(false)
  active         Boolean @default(true)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLineItems InvoiceLineItem[]

  @@unique([tenantId, code])
  @@index([tenantId, category, active])
  @@index([tenantId, active])
  @@index([tenantId, requiresDoctor, active])
}

// ============================================================================
// Medicine (+ DosageRange child table)
// ============================================================================

model Medicine {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  genericName String?
  brandNames  String[] @default([])
  form        MedicineForm
  strength    String
  unit        String
  route       MedicineRoute
  category    String

  indications        String[] @default([])
  contraindications  String[] @default([])
  sideEffects        String[] @default([])

  dosageRanges MedicineDosageRange[]

  standardDosage      String?
  standardFrequency   String?
  duration            String?
  requiresPrescription Boolean @default(true)
  controlledSubstance  Boolean @default(false)
  schedule             String?
  active               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryItems InventoryItem[]
  medications    PrescriptionMedication[]

  @@index([tenantId, category, active])
  @@index([tenantId, active])
  @@index([tenantId, requiresPrescription, active])
  @@index([tenantId, controlledSubstance])
}

model MedicineDosageRange {
  id           String   @id @default(uuid()) @db.Uuid
  medicineId   String   @db.Uuid
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  minAge       Int?
  maxAge       Int?
  minWeight    Float?
  maxWeight    Float?
  dose         String
  frequency    String
  maxDailyDose String?

  @@index([medicineId])
}

// ============================================================================
// Product
// ============================================================================

model Product {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  medicalRepresentativeId String?                @db.Uuid
  medicalRepresentative   MedicalRepresentative? @relation(fields: [medicalRepresentativeId], references: [id])

  name           String
  category       String
  manufacturer   String
  description    String
  dosage         String?
  strength       String?
  packaging      String
  expiryDate     DateTime
  status         ProductStatus @default(active)
  specifications String[]      @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, status])
  @@index([tenantId, category, status])
}

// ============================================================================
// Inventory
// ============================================================================

model InventoryItem {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  medicineId String?   @db.Uuid
  medicine   Medicine? @relation(fields: [medicineId], references: [id])

  name            String
  category        InventoryCategory
  sku             String?
  quantity        Int     @default(0)
  unit            String  @default("pieces")
  reorderLevel    Int     @default(10)
  reorderQuantity Int     @default(50)
  unitCost        Float   @default(0)
  supplier        String?
  expiryDate      DateTime?
  location        String?
  notes           String?
  lastRestocked   DateTime?

  lastRestockedById String? @db.Uuid
  lastRestockedBy   User?   @relation("InventoryLastRestockedBy", fields: [lastRestockedById], references: [id])

  status InventoryStatus @default(in_stock)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, category, status])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@index([tenantId, medicineId])
  @@index([tenantId, medicineId, status])
  @@index([tenantId, lastRestockedById])
  @@index([tenantId, status, expiryDate])
}

// ============================================================================
// Queue
// ============================================================================

model Queue {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  queueNumber String?
  queueType   QueueType

  patientId   String  @db.Uuid
  patient     Patient @relation(fields: [patientId], references: [id])
  patientName String

  appointmentId String?      @db.Uuid
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  visitId       String?      @db.Uuid
  visit         Visit?       @relation(fields: [visitId], references: [id])

  doctorId String? @db.Uuid
  doctor   Doctor? @relation(fields: [doctorId], references: [id])
  roomId   String? @db.Uuid
  room     Room?   @relation(fields: [roomId], references: [id])

  status             QueueStatus @default(waiting)
  priority           Int         @default(0)
  estimatedWaitTime  Int?

  queuedAt    DateTime  @default(now())
  calledAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  checkedIn     Boolean        @default(false)
  checkedInAt   DateTime?
  checkInMethod CheckInMethod?
  qrCode        String?

  consultationDuration Int?
  completionNotes      String?
  nextAction           QueueNextAction?

  // vitals (flattened - fixed shape struct; Mongoose stored as Mixed but shape is documented and fixed)
  vitalsBp       String?
  vitalsHr       Int?
  vitalsRr       Int?
  vitalsTempC    Float?
  vitalsSpo2     Int?
  vitalsHeightCm Float?
  vitalsWeightKg Float?
  vitalsBmi      Float?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, queueNumber])
  @@index([tenantId, status, priority, queuedAt])
  @@index([tenantId, doctorId, status, priority])
  @@index([tenantId, roomId, status])
  @@index([tenantId, checkedIn, status])
  @@index([tenantId, qrCode])
}

// ============================================================================
// Appointment
// ============================================================================

model Appointment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String? @db.Uuid
  doctor   Doctor? @relation(fields: [doctorId], references: [id])
  providerId String? @db.Uuid
  provider   User?   @relation("AppointmentProvider", fields: [providerId], references: [id])

  appointmentCode String?

  appointmentDate DateTime?
  appointmentTime String?
  scheduledAt     DateTime?
  duration        Int       @default(30)

  status AppointmentStatus @default(scheduled)

  isWalkIn          Boolean @default(false)
  queueNumber       Int?
  estimatedWaitTime Int?
  queueId           String? @db.Uuid
  // NOTE: no back-relation declared to Queue here to avoid a relation cycle
  // ambiguity with Queue.appointmentId; treat queueId as an informational FK.

  room String?

  reason String?
  notes  String? @default("")

  createdById String? @db.Uuid
  createdBy   User?   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queues       Queue[]
  visits       Visit[]
  documents    Document[]
  referrals    Referral[]

  @@unique([appointmentCode])
  @@index([tenantId, appointmentDate, appointmentTime])
  @@index([tenantId, doctorId, appointmentDate])
  @@index([tenantId, providerId, scheduledAt])
  @@index([tenantId, patientId, status])
  @@index([tenantId, status])
  @@index([tenantId, room, appointmentDate, appointmentTime])
  @@index([tenantId, doctorId])
  @@index([tenantId, providerId])
  @@index([tenantId, createdById])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, appointmentDate, status])
  @@index([tenantId, isWalkIn, appointmentDate])
  @@index([tenantId, room, status])
  @@index([tenantId, patientId, appointmentDate])
}

// ============================================================================
// Visit (+ children replacing embedded arrays/subdocs)
// ============================================================================

model Visit {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  patientId String  @db.Uuid
  patient   Patient @relation(fields: [patientId], references: [id])

  visitCode String
  date      DateTime  @default(now())

  providerId String? @db.Uuid
  provider   User?   @relation("VisitProvider", fields: [providerId], references: [id])

  visitType               VisitType @default(consultation)
  chiefComplaint          String?
  historyOfPresentIllness String?
  admittingImpression     String?

  // vitals (flattened - fixed shape struct, mirrors Queue.vitals shape)
  vitalsBp       String?
  vitalsHr       Int?
  vitalsRr       Int?
  vitalsTempC    Float?
  vitalsSpo2     Int?
  vitalsHeightCm Float?
  vitalsWeightKg Float?
  vitalsBmi      Float?

  // physicalExam (flattened - fixed shape struct, all free-text fields)
  peGeneral         String?
  peHeadEent        String?
  peHeent           String?
  peChest           String?
  peLungs           String?
  peCardiovascular  String?
  peAbdomen         String?
  peExtremities     String?
  peNeuro           String?
  peNeurological    String?
  peSkin            String?
  peLymphNotes      String?
  peBreast          String?
  peRectum          String?
  peGenitalia       String?
  peMusculoskeletal String?
  peOther           String?

  diagnoses VisitDiagnosis[]

  assessment String? // legacy, superseded by soapAssessment
  plan       String? // legacy, superseded by soapPlan

  // soapNotes (flattened - fixed shape struct)
  soapSubjective String?
  soapObjective  String?
  soapAssessment String?
  soapPlan       String?

  // treatmentPlan sub-structures -> child tables (independently meaningful lists)
  treatmentMedications VisitTreatmentMedication[]
  treatmentProcedures  VisitTreatmentProcedure[]
  treatmentLifestyle   VisitTreatmentLifestyle[]
  // treatmentPlan.followUp (flattened - single embedded object)
  treatmentFollowUpDate         DateTime?
  treatmentFollowUpInstructions String?
  treatmentFollowUpReminderSent Boolean?  @default(false)

  digitalSignature VisitDigitalSignature?

  // Reverse relations replacing Visit's redundant array-of-refs fields
  // (Prescription/LabResult/Imaging/Procedure each carry visitId back to Visit)
  prescriptions       Prescription[]
  labsOrdered         LabResult[]
  imagingOrdered      Imaging[]
  proceduresPerformed Procedure[]

  attachments VisitAttachment[]

  notes                 String?
  followUpDate           DateTime?
  followUpReminderSent    Boolean?  @default(false)
  feedbackRequested        Boolean?  @default(false)
  feedbackToken             String?  @unique

  status VisitStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices       Invoice[]
  queues         Queue[]
  documents      Document[]
  referrals      Referral[]
  appointmentId  String?      @db.Uuid
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  surveyResponse SurveyResponse?

  @@index([tenantId, patientId, date])
  @@index([tenantId, providerId])
  @@index([tenantId, providerId, date])
  @@index([tenantId, status, date])
  @@index([tenantId, visitCode])
  @@index([tenantId, visitType, date])
  @@index([tenantId, date, status])
  @@index([tenantId, patientId, status])
}

model VisitDiagnosis {
  id          String  @id @default(uuid()) @db.Uuid
  visitId     String  @db.Uuid
  visit       Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
